.venv/
__pycache__/
*.pyc
.DS_Store
# q3 web rungs create their SQLite DB at runtime
books.db
# worksheets/*/build/: PDFs and figure images are checked in; LaTeX intermediates are not
worksheets/**/build/**/*.tex
worksheets/**/build/**/*.aux
worksheets/**/build/**/*.log

# misc/*/build/: keep PDFs, drop LaTeX intermediates
misc/**/build/**/*.tex
misc/**/build/**/*.aux
misc/**/build/**/*.log

# papers/*/build/: keep PDFs, drop LaTeX intermediates
papers/**/build/**/*.tex
papers/**/build/**/*.aux
papers/**/build/**/*.log

# exams/*/build/: same again -- the question-paper PDFs are checked in
exams/**/build/**/*.tex
exams/**/build/**/*.aux
exams/**/build/**/*.log
